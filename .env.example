# Create a bcrypt hash of your admin password and place it here.
# E.g., using node: require('bcrypt').hashSync('yourpassword', 10)
ADMIN_PASSWORD_HASH=

# REQUIRED: Generate a strong, random secret key for session JWT signing.
# If this is missing, the app will refuse to start.
# E.g., using terminal: openssl rand -base64 32
JWT_SECRET=
