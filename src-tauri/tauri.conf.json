{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "docker-manager",
  "version": "1.0.11",
  "identifier": "com.dockermanager.app",
  "build": {
    "frontendDist": "../tauri-ui",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Docker Manager",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../.next/standalone/**/*",
      "../.next/static/**/*",
      "../public/**/*",
      "../start.js"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}